APP_ENV=dev
APP_AUTH_ENABLED=0
APP_AUTH_USERNAME=
# PBKDF2-SHA256 format. Required when APP_AUTH_ENABLED=1.
APP_AUTH_PASSWORD_HASH=

# SQLite de démonstration
DATABASE_URL=sqlite:///db/demo.db

# Historique et vues sauvegardées
INTERNAL_DB_URL=sqlite:///db/internal.db

# Ollama local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=60

# Optionnel. Si vide, une clé est créée dans config/.fernet_key
# Required in production. In development only, an absent key is created locally.
FERNET_KEY=

# Optionnel, seulement si openai-whisper est installé
WHISPER_MODEL=small
